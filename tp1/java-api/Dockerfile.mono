# Version mono-stage, uniquement pour comparer la taille avec le multi-stage.
# L'image finale garde le JDK, Maven, le cache ~/.m2 et les sources.
FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "target/java-api-1.0.0.jar"]
